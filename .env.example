# ─────────────────────────────────────────────────────────────────────────────
# Synvora Lead Intelligence — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Vercel deployment, add these as Environment Variables in the Vercel dashboard:
#   Project → Settings → Environment Variables
#
# All variables MUST be prefixed with VITE_ to be accessible in the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Apify Token — for Google Maps & web scraping
VITE_APIFY_TOKEN=

# Hunter.io API Key — for email enrichment
VITE_HUNTER_API_KEY=

# Gemini AI API Key — for AI outreach drafting (primary)
VITE_GEMINI_API_KEY=

# Grok xAI API Key — fallback when Gemini quota is exhausted
VITE_GROK_API_KEY=

# Google Apps Script Webhook URL — for auto-syncing leads to Google Sheets
VITE_GOOGLE_SHEET_WEBHOOK_URL=

# Google Sheet direct URL — shown as "Open Sheet" button in navbar
VITE_GOOGLE_SHEET_URL=
